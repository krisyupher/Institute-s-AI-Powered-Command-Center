# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files
# Frontend-specific rules live in FrontEnd/.gitignore

# --- .NET ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.userprefs
.vs/
TestResults/
[Cc]overage*/
*.coverage
*.trx
project.lock.json
project.fragment.lock.json

# --- Local database (reseeded on API start) ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
appsettings.Development.local.json
appsettings.*.Local.json
secrets.json

# --- Node (outside FrontEnd) ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Editors ---
.idea/
*.swp
.history/

# --- System files ---
.DS_Store
Thumbs.db

# --- Local agent instructions ---
CLAUDE.md
CLAUDE.md
\CLAUDE.md
